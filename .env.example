VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=NexStep

# Optional — "Sign in with Google" on /admin/login. Leave unset to hide the
# button. Must match Backend's GOOGLE_CLIENT_ID exactly (see Backend/.env.example
# for how to create it) — client IDs are public, safe to expose here.
VITE_GOOGLE_CLIENT_ID=

# Optional — reCAPTCHA v2 Invisible badge on /admin/login (bottom-right
# corner). Leave unset to skip it. This is the SITE key (public) from the
# same reCAPTCHA registration as Backend's RECAPTCHA_SECRET_KEY.
VITE_RECAPTCHA_SITE_KEY=
